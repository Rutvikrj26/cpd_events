# Accredit transcription agent — environment template.
# Copy to .env.dev for local docker-compose use; Cloud Run injects
# these directly via the deployment config.

# ---------- LiveKit ---------------------------------------------------------
# Where the agent connects to find the room. In dev: the local LiveKit
# emulator container; in prod: your LiveKit Cloud or self-hosted server.
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_dev_key_change_in_production

# ---------- Backend ---------------------------------------------------------
# Where finalized segments are POSTed. In docker-compose this is the
# `backend` service hostname; in Cloud Run, the internal service URL.
BACKEND_INTERNAL_URL=http://backend:8000

# Shared HMAC secret. The Django web service has the same value in its
# settings — both must agree. Generate with `openssl rand -hex 32` for
# any non-dev deployment.
INTERNAL_AGENT_SHARED_SECRET=dev_only_change_me

# ---------- Transcription ---------------------------------------------------
# null | google | deepgram | openai | assemblyai
# 'null' is the safe default — agent boots and joins rooms but no STT
# is wired up. Set to one of the four real providers to enable live
# captioning + post-event transcripts.
TRANSCRIPTION_PROVIDER=null

# Google Cloud Speech-to-Text v2 (path 'google'). Path to a GCP
# service-account JSON file. Cloud Speech is the dedicated streaming
# STT service — chirp_2 model, ~$0.024/min, 60 min/month free.
# Setup: GCP project → enable Speech-to-Text API → service account
# with 'Cloud Speech Client' role → download JSON → mount via volume
# → point this var at the in-container path.
GOOGLE_APPLICATION_CREDENTIALS=

# Other provider API keys. Only the one matching TRANSCRIPTION_PROVIDER
# is required at runtime; leave the others blank.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=

# ---------- Diagnostics -----------------------------------------------------
HEALTH_PORT=8081
