# =============================================================================
# BACKEND LOCAL DEVELOPMENT
# =============================================================================
# Copy to .env.dev and fill in your values:
#   cp .env.dev.template .env.dev
#
# Only secrets and values without sensible defaults are required.
# Django settings, debug mode, allowed hosts, etc. have defaults in code.
# =============================================================================

# -----------------------------------------------------------------------------
# Required Secrets
# -----------------------------------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# -----------------------------------------------------------------------------
# Stripe (get test keys from dashboard.stripe.com/apikeys)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# -----------------------------------------------------------------------------
# Ticketing + Stripe Tax (optional - defaults are in code)
# -----------------------------------------------------------------------------
# Ticketing uses destination charges (platform is merchant of record).
# Optional fee overrides (per currency):
# TICKETING_SERVICE_FEE_PERCENT_CAD=3.0
# TICKETING_SERVICE_FEE_FIXED_CAD=0.99
# TICKETING_PROCESSING_FEE_PERCENT_CAD=2.9
# TICKETING_PROCESSING_FEE_FIXED_CAD=0.30
# TICKETING_SERVICE_FEE_PERCENT_USD=3.0
# TICKETING_SERVICE_FEE_FIXED_USD=0.99
# TICKETING_PROCESSING_FEE_PERCENT_USD=2.9
# TICKETING_PROCESSING_FEE_FIXED_USD=0.30

# -----------------------------------------------------------------------------
# LiveKit Video Conferencing (optional - defaults work with docker-compose)
# -----------------------------------------------------------------------------
# For local development with docker-compose, these defaults match livekit.yaml
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret_dev_key_change_in_production
# LIVEKIT_HOST=http://livekit:7880
# LIVEKIT_WS_URL=ws://localhost:7880

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

# -----------------------------------------------------------------------------
# SMTP provider (optional - only if testing real email sending)
# Default: emails print to console
# -----------------------------------------------------------------------------
# SMTP_API_KEY=your-provider-api-key
# SMTP_DOMAIN=your-smtp-domain
# SMTP_LOGIN=your-smtp-login
# SMTP_PASSWORD=your-smtp-password
# SMTP_SERVER=smtp-relay.brevo.com
# SMTP_PORT=587

# -----------------------------------------------------------------------------
# GCP (optional - only if using real GCP instead of emulators/sync mode)
# Default: Cloud Tasks run synchronously, no GCS bucket
# -----------------------------------------------------------------------------
# GCP_PROJECT_ID=your-gcp-project-id
# GCS_BUCKET_NAME=your-bucket-name

# -----------------------------------------------------------------------------
# PostgreSQL (optional - default uses SQLite)
# -----------------------------------------------------------------------------
# DB_NAME=cpd_events
# DB_USER=cpd_user
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# -----------------------------------------------------------------------------
# Deployment Configuration (single-tenant institutional deployment)
# -----------------------------------------------------------------------------
DEPLOYMENT_MODE=single_tenant
REGISTRATION_MODE=invite_only
INSTITUTION_NAME=Accredit
# INSTITUTION_LOGO_URL=https://example.com/logo.png

# ISO-4217 currency code used as default for events/courses/programs
INSTITUTION_DEFAULT_CURRENCY=USD
