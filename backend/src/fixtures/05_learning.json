      "created_at": "2025-02-01T12:30:00Z",
      "updated_at": "2025-02-01T12:30:00Z",
      "module": 2,
      "title": "Ethics Case Study Analysis",
      "description": "Analyze a provided clinical ethics case study using the frameworks learned.",
      "instructions": "Read the provided case study carefully. Using the ethical framework from the course materials, write a 500-800 word analysis addressing: 1) The key ethical issues, 2) Stakeholder perspectives, 3) Your recommended course of action with justification.",
      "due_days_after_release": 14,
      "max_score": 100,
      "passing_score": 70,
      "allow_resubmission": true,
      "max_attempts": 3,
      "submission_type": "text",
      "rubric": {
        "criteria": [
          {
            "name": "Issue Identification",
            "max_points": 25,
            "description": "Correctly identifies all ethical issues"
          },
          {
            "name": "Framework Application",
            "max_points": 30,
            "description": "Properly applies ethical framework"
          },
          {
            "name": "Stakeholder Analysis",
            "max_points": 20,
            "description": "Considers all relevant stakeholders"
          },
          {
            "name": "Recommendation Quality",
            "max_points": 25,
            "description": "Provides well-reasoned recommendation"
          }
        ]
      }
    }
  },
