api_key: devkey
api_secret: secret_dev_key_change_in_production
ws_url: ws://localhost:7880
redis:
  address: localhost:6379
log_level: debug
insecure: false
# Use the SDK-based compositor (GStreamer) instead of the Chrome-based
# template compositor. The SDK path is simpler for local dev — it joins
# the room as a hidden participant, subscribes to tracks, and composites
# them server-side without needing a headless browser.
enable_room_composite_sdk_source: true
debug:
  enable_chrome_logging: true
